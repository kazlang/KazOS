// ============================================================================
// KazOS Bare-Metal Transpiler (Escrito 100% em Kaz)
// Compila módulos .kaz do sistema operacional (Kaz-UI, Kaz-X, Kernel Logic)
// diretamente para código bare-metal freestanding sem dependências externas!
// ============================================================================

import "/home/armando/Projetos/kaz/compiler/token.kaz";
import "/home/armando/Projetos/kaz/compiler/lexer.kaz";
import "/home/armando/Projetos/kaz/compiler/ast.kaz";
import "/home/armando/Projetos/kaz/compiler/parser.kaz";
import "/home/armando/Projetos/kaz/compiler/loader.kaz";

struct GlobalInfo {
    string name;
    string type_name;
}

array[GlobalInfo] g_bm_globals = [];

function bm_parse_int_str(string s): int {
    if (str_starts_with(s, "0x") || str_starts_with(s, "0X")) {
        int val = 0;
        int i = 2;
        int n = str_len(s);
        while (i < n) {
            string ch = str_substring(s, i, i + 1);
            int d = 0;
            if (ch == "0") { d = 0; }
            else if (ch == "1") { d = 1; }
            else if (ch == "2") { d = 2; }
            else if (ch == "3") { d = 3; }
            else if (ch == "4") { d = 4; }
            else if (ch == "5") { d = 5; }
            else if (ch == "6") { d = 6; }
            else if (ch == "7") { d = 7; }
            else if (ch == "8") { d = 8; }
            else if (ch == "9") { d = 9; }
            else if (ch == "a" || ch == "A") { d = 10; }
            else if (ch == "b" || ch == "B") { d = 11; }
            else if (ch == "c" || ch == "C") { d = 12; }
            else if (ch == "d" || ch == "D") { d = 13; }
            else if (ch == "e" || ch == "E") { d = 14; }
            else if (ch == "f" || ch == "F") { d = 15; }
            val = val * 16 + d;
            i = i + 1;
        }
        return val;
    }
    return to_int(s);
}

function bm_normalize_tokens(array[Token] tokens): array[Token] {
    int i = 0;
    int n = tokens.len;
    while (i < n) {
        Token tk = tokens[i];
        if (tk.kind == TokenType::IntLiteral) {
            if (str_starts_with(tk.lexeme, "0x") || str_starts_with(tk.lexeme, "0X")) {
                tokens[i].lexeme = to_string(bm_parse_int_str(tk.lexeme));
            }
        }
        i = i + 1;
    }
    return tokens;
}

function bm_map_type(string tname): string {
    if (tname == "int" || tname == "i32" || tname == "i64") {
        return "int";
    }
    if (tname == "u32" || tname == "u64") {
        return "unsigned int";
    }
    if (tname == "u8") {
        return "unsigned char";
    }
    if (tname == "bool" || tname == "bol") {
        return "int";
    }
    if (tname == "string") {
        return "const char*";
    }
    if (tname == "char") {
        return "char";
    }
    if (tname == "void" || tname == "") {
        return "void";
    }
    return "struct " + tname;
}

function bm_escape_string(string s): string {
    string res = "";
    int i = 0;
    int len = str_len(s);
    while (i < len) {
        string ch = str_substring(s, i, i + 1);
        if (ch == "\n") {
            res = res + "\\n";
        } else if (ch == "\r") {
            res = res + "\\r";
        } else if (ch == "\t") {
            res = res + "\\t";
        } else if (ch == "\"") {
            res = res + "\\\"";
        } else if (ch == "\\") {
            res = res + "\\\\";
        } else {
            res = res + ch;
        }
        i = i + 1;
    }
    return res;
}

function bm_binop_str(AstBinaryOp op): string {
    if (op == AstBinaryOp::Add) { return "+"; }
    if (op == AstBinaryOp::Sub) { return "-"; }
    if (op == AstBinaryOp::Mul) { return "*"; }
    if (op == AstBinaryOp::Div) { return "/"; }
    if (op == AstBinaryOp::Mod) { return "%"; }
    if (op == AstBinaryOp::Eq)  { return "=="; }
    if (op == AstBinaryOp::Ne)  { return "!="; }
    if (op == AstBinaryOp::Lt)  { return "<"; }
    if (op == AstBinaryOp::Lte) { return "<="; }
    if (op == AstBinaryOp::Gt)  { return ">"; }
    if (op == AstBinaryOp::Gte) { return ">="; }
    if (op == AstBinaryOp::And) { return "&&"; }
    if (op == AstBinaryOp::Or)  { return "||"; }
    if (op == AstBinaryOp::BitAnd) { return "&"; }
    if (op == AstBinaryOp::BitOr)  { return "|"; }
    if (op == AstBinaryOp::BitXor) { return "^"; }
    if (op == AstBinaryOp::Shl)    { return "<<"; }
    if (op == AstBinaryOp::Shr)    { return ">>"; }
    return "+";
}

function bm_emit_expr(int expr_idx): string {
    if (expr_idx < 0 || expr_idx >= g_expr_arena.len) {
        return "0";
    }
    AstExpr e = g_expr_arena[expr_idx];

    if (e.kind == ExprKind::LiteralInt) {
        return to_string(e.int_val);
    }

    if (e.kind == ExprKind::LiteralBool) {
        if (e.bool_val) {
            return "1";
        }
        return "0";
    }

    if (e.kind == ExprKind::LiteralString) {
        return "\"" + bm_escape_string(e.string_val) + "\"";
    }

    if (e.kind == ExprKind::LiteralChar) {
        return "'" + bm_escape_string(e.string_val) + "'";
    }

    if (e.kind == ExprKind::LiteralNull) {
        return "0";
    }

    if (e.kind == ExprKind::Identifier) {
        return e.string_val;
    }

    if (e.kind == ExprKind::Unary) {
        string operand = bm_emit_expr(e.left_idx);
        if (e.un_op == AstUnaryOp::Not) {
            return "(!" + operand + ")";
        }
        if (e.un_op == AstUnaryOp::Neg) {
            return "(-" + operand + ")";
        }
        if (e.un_op == AstUnaryOp::BitNot) {
            return "(~" + operand + ")";
        }
        return operand;
    }

    if (e.kind == ExprKind::Binary) {
        AstExpr left_e = g_expr_arena[e.left_idx];
        AstExpr right_e = g_expr_arena[e.right_idx];

        string l_str = bm_emit_expr(e.left_idx);
        string r_str = bm_emit_expr(e.right_idx);

        // Comparação de strings com == ou != caso uma das pontas seja literal string
        if (e.bin_op == AstBinaryOp::Eq) {
            if (left_e.kind == ExprKind::LiteralString || right_e.kind == ExprKind::LiteralString) {
                return "(strcmp(" + l_str + ", " + r_str + ") == 0)";
            }
        }
        if (e.bin_op == AstBinaryOp::Ne) {
            if (left_e.kind == ExprKind::LiteralString || right_e.kind == ExprKind::LiteralString) {
                return "(strcmp(" + l_str + ", " + r_str + ") != 0)";
            }
        }

        return "(" + l_str + " " + bm_binop_str(e.bin_op) + " " + r_str + ")";
    }

    if (e.kind == ExprKind::FieldAccess) {
        string obj = bm_emit_expr(e.left_idx);
        return obj + "." + e.string_val;
    }

    if (e.kind == ExprKind::IndexAccess) {
        string arr = bm_emit_expr(e.left_idx);
        string idx = bm_emit_expr(e.right_idx);
        return arr + "[" + idx + "]";
    }

    if (e.kind == ExprKind::StructInit) {
        string fields_c = "";
        int i = 0;
        while (i < e.field_names.len) {
            string fname = e.field_names[i];
            int fval_idx = e.args_idx[i];
            string fval = bm_emit_expr(fval_idx);
            if (i > 0) {
                fields_c = fields_c + ", ";
            }
            fields_c = fields_c + "." + fname + " = " + fval;
            i = i + 1;
        }
        return "(struct " + e.string_val + "){ " + fields_c + " }";
    }

    if (e.kind == ExprKind::Call) {
        string callee = bm_emit_expr(e.left_idx);
        if (callee == "runoff") {
            callee = "kaz_sys_log";
        }
        string args_c = "";
        int i = 0;
        while (i < e.args_idx.len) {
            if (i > 0) {
                args_c = args_c + ", ";
            }
            args_c = args_c + bm_emit_expr(e.args_idx[i]);
            i = i + 1;
        }
        return callee + "(" + args_c + ")";
    }

    return "0";
}

function bm_emit_stmt(int stmt_idx, string indent): string {
    if (stmt_idx < 0 || stmt_idx >= g_stmt_arena.len) {
        return "";
    }
    AstStmt s = g_stmt_arena[stmt_idx];

    if (s.kind == StmtKind::VarDecl) {
        string c_type = bm_map_type(s.type_name);
        if (s.expr_idx >= 0) {
            string init_c = bm_emit_expr(s.expr_idx);
            return indent + c_type + " " + s.name + " = " + init_c + ";\n";
        }
        return indent + c_type + " " + s.name + ";\n";
    }

    if (s.kind == StmtKind::Assignment) {
        string lhs = s.name;
        for (p_idx in s.body_stmt_indices) {
            AstExpr pe = g_expr_arena[p_idx];
            if (pe.kind == ExprKind::LiteralString) {
                lhs = lhs + "." + pe.string_val;
            } else {
                lhs = lhs + "[" + bm_emit_expr(p_idx) + "]";
            }
        }
        string rhs = bm_emit_expr(s.expr_idx);
        return indent + lhs + " = " + rhs + ";\n";
    }

    if (s.kind == StmtKind::Return) {
        if (s.expr_idx >= 0) {
            return indent + "return " + bm_emit_expr(s.expr_idx) + ";\n";
        }
        return indent + "return;\n";
    }

    if (s.kind == StmtKind::Break) {
        return indent + "break;\n";
    }

    if (s.kind == StmtKind::Continue) {
        return indent + "continue;\n";
    }

    if (s.kind == StmtKind::Expression) {
        return indent + bm_emit_expr(s.expr_idx) + ";\n";
    }

    if (s.kind == StmtKind::Block) {
        string out = indent + "{\n";
        for (b_idx in s.body_stmt_indices) {
            out = out + bm_emit_stmt(b_idx, indent + "    ");
        }
        out = out + indent + "}\n";
        return out;
    }

    if (s.kind == StmtKind::If) {
        string cond_c = bm_emit_expr(s.cond_idx);
        string out = indent + "if (" + cond_c + ") {\n";
        for (t_idx in s.body_stmt_indices) {
            out = out + bm_emit_stmt(t_idx, indent + "    ");
        }
        if (s.else_stmt_indices.len > 0) {
            out = out + indent + "} else {\n";
            for (e_idx in s.else_stmt_indices) {
                out = out + bm_emit_stmt(e_idx, indent + "    ");
            }
        }
        out = out + indent + "}\n";
        return out;
    }

    if (s.kind == StmtKind::While) {
        string cond_c = bm_emit_expr(s.cond_idx);
        string out = indent + "while (" + cond_c + ") {\n";
        for (b_idx in s.body_stmt_indices) {
            out = out + bm_emit_stmt(b_idx, indent + "    ");
        }
        out = out + indent + "}\n";
        return out;
    }

    return "";
}

function bm_emit_struct_def(AstStmt s): string {
    string out = "struct " + s.name + " {\n";
    for (f in s.fields) {
        out = out + "    " + bm_map_type(f.type_name) + " " + f.name + ";\n";
    }
    out = out + "};\n\n";
    return out;
}

function bm_is_kernel_intrinsic(string fn_name): bool {
    if (fn_name == "main") { return true; }
    if (str_starts_with(fn_name, "sys_")) { return true; }
    return false;
}

function bm_emit_fn_decl(AstStmt s): string {
    if (bm_is_kernel_intrinsic(s.name)) {
        return "";
    }
    string ret_c = bm_map_type(s.type_name);
    string params_c = "";
    int i = 0;
    while (i < s.params.len) {
        AstParam p = s.params[i];
        if (i > 0) {
            params_c = params_c + ", ";
        }
        params_c = params_c + bm_map_type(p.type_name) + " " + p.name;
        i = i + 1;
    }
    string fn_name = s.name;
    string out = ret_c + " " + fn_name + "(" + params_c + ") {\n";
    for (b_idx in s.body_stmt_indices) {
        out = out + bm_emit_stmt(b_idx, "    ");
    }
    out = out + "}\n\n";
    return out;
}

function main() {
    if (args_len() < 2) {
        runoff("Uso: kaz run tools/kazos_cc.kaz -- <entrada.kaz> <saida.h>");
        return;
    }
    string input_file = argv(0);
    string output_file = argv(1);

    runoff("[KazOS-CC] Bundling modulos Kaz a partir de:", input_file);
    string bundled = loader_bundle("", input_file);
    if (bundled == "") {
        bundled = file_read(input_file);
    }

    runoff("[KazOS-CC] Tokenizando (" + to_string(str_len(bundled)) + " bytes)...");
    array[Token] raw_tokens = lexer_tokenize(bundled);
    runoff("[KazOS-CC] Normalizando " + to_string(raw_tokens.len) + " tokens...");
    array[Token] tokens = bm_normalize_tokens(raw_tokens);
    runoff("[KazOS-CC] Analisando AST...");
    ParserState parsed = parser_parse(tokens);
    runoff("[KazOS-CC] Gerando C para " + to_string(g_top_level_stmt_indices.len) + " declaracoes...");

    string out = "/* =========================================================================\n";
    out = out + " * GERADO AUTOMATICAMENTE PELO COMPILADOR KAZ BARE-METAL (kazos_cc.kaz)\n";
    out = out + " * Fonte original: " + input_file + "\n";
    out = out + " * ========================================================================= */\n\n";

    // 1. Emite todas as structs primeiro
    for (idx in g_top_level_stmt_indices) {
        AstStmt s = g_stmt_arena[idx];
        if (s.kind == StmtKind::StructDef) {
            out = out + bm_emit_struct_def(s);
        }
    }

    // 2. Emite variaveis globais de nivel superior
    for (idx in g_top_level_stmt_indices) {
        AstStmt s = g_stmt_arena[idx];
        if (s.kind == StmtKind::VarDecl) {
            out = out + bm_emit_stmt(idx, "");
        }
    }
    out = out + "\n";

    // 3. Emite prototipos das funcoes para permitir chamadas em qualquer ordem
    for (idx in g_top_level_stmt_indices) {
        AstStmt s = g_stmt_arena[idx];
        if (s.kind == StmtKind::FunctionDecl && !bm_is_kernel_intrinsic(s.name)) {
            string ret_c = bm_map_type(s.type_name);
            string params_c = "";
            int i = 0;
            while (i < s.params.len) {
                AstParam p = s.params[i];
                if (i > 0) {
                    params_c = params_c + ", ";
                }
                params_c = params_c + bm_map_type(p.type_name) + " " + p.name;
                i = i + 1;
            }
            string fn_name = s.name;
            out = out + ret_c + " " + fn_name + "(" + params_c + ");\n";
        }
    }
    out = out + "\n";

    // 4. Emite definicoes das funcoes
    for (idx in g_top_level_stmt_indices) {
        AstStmt s = g_stmt_arena[idx];
        if (s.kind == StmtKind::FunctionDecl) {
            out = out + bm_emit_fn_decl(s);
        }
    }

    file_write(output_file, out);
    runoff("[KazOS-CC] Sucesso! Codigo bare-metal gerado em:", output_file);
}
